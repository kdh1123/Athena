{
  "expo": {
    "name": "Athena",
    "slug": "Athena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kdh1123.Athena",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Athena가 사진과 동영상 목록을 분석해 정리 추천을 제공하기 위해 접근 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Athena가 사진과 동영상 목록을 분석해 정리 추천을 제공하기 위해 접근 권한이 필요합니다.",
          "savePhotosPermission": "Athena가 정리 결과를 저장할 때 사진 라이브러리 접근 권한이 필요합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1bcb8cdb-173b-4fb6-8750-12073de38ea2"
      }
    }
  }
}
